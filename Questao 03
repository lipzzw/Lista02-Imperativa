import java.util.Scanner;
public class Q3 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int[] vet = new int[10];

        for(int i = 0; i < vet.length; i++){
            System.out.println("Digite um numero");
            vet[i] = s.nextInt();  
        }
        for(int i = 0; i < vet.length; i++){
                if(vet[i] % 2 == 0 && vet[i] != 0){
                    System.out.println("---------------");
                    System.out.println(vet[i]);
                }
            }
    }
}
