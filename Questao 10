import java.util.Scanner;
public class Q10 {

    public static int[] calculaSoma(int[]x, int[]y){
        int[] soma = new int[x.length];
        for(int i = 0; i < x.length; i++){
            soma[i] = x[i] + y[i];
        }
        return soma;
        
    }
    public static int[] calculaProduto(int[]x, int[]y){
        int[] produto = new int[x.length];
        for(int i = 0; i < x.length; i++){
            produto[i] = x[i]*y[i];
        }
        return produto;
    }
    public static int[] calculaDiferenca(int[]x, int[]y){
        int[] diferenca = new int[x.length];
        int contador = 0;
        for(int i = 0; i < x.length; i++){
            boolean existe = false;
            for(int j = 0; j < y.length; j++){
                if(x[i] == y[j]){
                    existe = true;
                }
            }
            if(existe == false){
                diferenca[contador] = x[i];
                contador++; 
                }        
            }
            return diferenca;
        }
        public static int[] calculaIntercecao(int[]x, int[]y){
            int[] intercecao = new int[x.length];
            int contador = 0;
            for(int i = 0; i < x.length; i++){
                boolean existe = false;
                for(int j = 0; j < y.length; j++){
                    if(x[i] == y[j]){
                        existe = true;
                    }
                }
                if(existe == true){
                    intercecao[contador] = x[i];
                    contador++;
                }
            }
            return intercecao;
        }
        public static int[] calculaUniao(int[]x, int[]y){
            int[] uniao = new int[x.length];
            int contador = 0;
            for(int i = 0; i < y.length; i++){
                boolean existe = false;
                for(int j = 0; j < x.length; j++){
                    if(y[i] == x[j]){
                        existe = true;
                    }
                }
                if(existe == true){
                    uniao[contador] = y[i];
                    contador++;
                } 
            }
            return uniao;
        }        
        
    
    public static void main(String[] args){
        Scanner s = new Scanner(System.in);

        int[] x = new int[5];
        int[] y = new int[5];

        for(int i = 0; i < x.length; i++){
            System.out.println("Digite um numero para o vetor x");
            x[i] = s.nextInt();
        }
        for(int i = 0; i < y.length; i++){
            System.out.println("Digite um numero para o vetor y");
            y[i] = s.nextInt();
        }
        
        int[] soma = calculaSoma(x, y);
        int[] produto = calculaProduto(x, y);
        int[] diferenca = calculaDiferenca(x, y);
        int[] intercecao = calculaIntercecao(x, y);
        int[] uniao = calculaUniao(x, y);

        for(int i = 0; i < soma.length; i++){
            System.out.println("Soma: " +soma[i]);
        }
        for(int i = 0; i < produto.length; i++){
            System.out.println("Produto: "+produto[i]);
        }
        for(int i = 0; i < diferenca.length; i++){
            System.out.println("Diferença: "+diferenca[i]);
        }
        for(int i = 0; i < intercecao.length; i++){
            System.out.println("Intercecao: "+intercecao[i]);
        }
        for(int i = 0; i < uniao.length; i++){
            System.out.println("uniao: "+uniao[i]);
        }  
    }
}
