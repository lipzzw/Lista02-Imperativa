import java.util.Scanner;
public class Q1matrizes {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int[][] mt = new int[4][4];
        int contador = 0;

        for(int i = 0; i < mt.length; i++){
            for(int j = 0; j < mt[i].length; j++){
                mt[i][j] = s.nextInt();
            }
        }

        for(int i = 0; i < mt.length; i++){
            for(int j = 0; j < mt[i].length; j++){
                if(mt[i][j] > 10){
                    contador++;
                }
            }
        }

        for (int i = 0; i < mt.length; i++) {
            for (int j = 0; j < mt[i].length; j++) {
                System.out.printf("%4d", mt[i][j]);
            }
            System.out.println();
        }
        System.out.println("-------------------");
         System.out.println("Quantidade de numeros maiores que Dez: "+ contador);
    }
}
