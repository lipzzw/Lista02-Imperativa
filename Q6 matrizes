public class Q6matrizes {

    public static void main(String[] args) {

        int[][] matriz = new int[10][10];

        for (int i = 0; i < matriz.length; i++) {
            for (int j = 0; j < matriz[i].length; j++) {

                if (i < j) {

                    matriz[i][j] = 2 * i + 7 * j - 2;

                } else if (i == j) {

                    matriz[i][j] = 3 * i * i - 1;

                } else {

                    matriz[i][j] = 4 * i * i * i
                                 - 5 * j * j + 1;

                }
            }
        }

        
        for (int i = 0; i < matriz.length; i++) {
            for (int j = 0; j < matriz[i].length; j++) {

                System.out.print(matriz[i][j] + "\t");

            }

            System.out.println();
        }
    }
}
