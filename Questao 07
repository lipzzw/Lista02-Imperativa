import java.util.Scanner;
public class Q7 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int[] vet1 = new int[20];
        int[] vet2 = new int[20];
        int[] vet3 = new int[40];

        for(int i = 0; i < vet1.length; i++){
            System.out.println("Digite um numero para o vetor 1");
            vet1[i] = s.nextInt();

            System.out.println("Digite um numero para o vetor 2");
            vet2[i] = s.nextInt();
        }
        for(int i = 0; i < vet1.length; i++){
            vet3[i*2] = vet1[i];
            vet3[i*2+1] = vet2[i];
        }
        for(int i = 0; i < vet3.length; i++){
            System.out.println(vet3[i]);
        }
    }
}
