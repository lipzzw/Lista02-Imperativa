public class Q2matrizes {
    public static void main(String[] args) {
        int[][] mt = new int[5][5];

        for(int i = 0; i < mt.length; i++){
            for(int j = 0; j < mt[i].length; j++){
                if(i == j){
                    mt[i][j] = 1;
                }else{
                    mt[i][j] = 0;
                }
            }
        }
         for (int i = 0; i < mt.length; i++) {
            for (int j = 0; j < mt[i].length; j++) {
                System.out.printf("%4d", mt[i][j]);
            }
            System.out.println();
        }
    }
}
