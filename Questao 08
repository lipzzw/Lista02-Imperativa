        Scanner s = new Scanner(System.in);
        int[] v = new int[10];
        int[] v2 = new int[10];
        int[] v3 = new int[20];

        for(int i = 0; i < v.length; i++){
            System.out.println("Digite um numero");
            v[i] = s.nextInt();
        }
        for(int i = 0; i < v2.length; i++){
            System.out.println("DDigite um numero");
