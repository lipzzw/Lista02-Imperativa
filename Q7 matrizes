import java.util.Scanner;

public class Q7matrizes {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int[][] matriz = new int[3][3];

        int somaAcima = 0;
        int somaAbaixo = 0;
        int somaPrincipal = 0;
        int somaSecundaria = 0;

        
        for (int i = 0; i < matriz.length; i++) {
            for (int j = 0; j < matriz[i].length; j++) {

                System.out.print("Digite o valor [" + i + "][" + j + "]: ");
                matriz[i][j] = sc.nextInt();

            }
        }

        
        for (int i = 0; i < matriz.length; i++) {
            for (int j = 0; j < matriz[i].length; j++) {

                if (i < j) {
                    somaAcima += matriz[i][j];
                }

                if (i > j) {
                    somaAbaixo += matriz[i][j];
                }

                if (i == j) {
                    somaPrincipal += matriz[i][j];
                }

                if (i + j == 2) {
                    somaSecundaria += matriz[i][j];
                }
            }
        }

       
        System.out.println("\nSoma acima da diagonal principal: " + somaAcima);
        System.out.println("Soma abaixo da diagonal principal: " + somaAbaixo);
        System.out.println("Soma diagonal principal: " + somaPrincipal);
        System.out.println("Soma diagonal secundária: " + somaSecundaria);

        sc.close();
    }
}
